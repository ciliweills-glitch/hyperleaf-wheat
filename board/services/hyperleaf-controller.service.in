[Unit]
Description=HyperLeaf screen sessions and spectra
Requires=hyperleaf-cnn.service
After=hyperleaf-cnn.service

[Service]
Type=simple
Environment=TZ=Asia/Shanghai
WorkingDirectory=@PROJECT_ROOT@/ui/screen
ExecStart=/usr/local/share/pynq-venv/bin/python3 -u controller.py --runtime runtime --control-uart /dev/ttyPS0
ExecStartPost=/usr/bin/python3 @PROJECT_ROOT@/ui/screen/systemd/wait_port.py 8766
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
