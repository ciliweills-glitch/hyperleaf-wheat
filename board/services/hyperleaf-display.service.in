[Unit]
Description=HyperLeaf AN970 KMS touch display
Requires=hyperleaf-controller.service
After=hyperleaf-controller.service

[Service]
Type=simple
ExecStart=@PROJECT_ROOT@/ui/screen/kms_screen /dev/dri/card1 /dev/input/event0 @PROJECT_ROOT@/ui/screen/runtime/screen.argb 8766 @PROJECT_ROOT@/ui/screen/runtime/count_cards.argb
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
